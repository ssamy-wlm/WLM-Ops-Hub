{
  "version": 2,
  "functions": {
    "api/ops-state.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/admin",
      "dest": "/index.html"
    },
    {
      "src": "/user",
      "dest": "/user.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-overdue-check",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron-overdue-check",
      "schedule": "0 7 * * 1-5"
    }
  ]
}
