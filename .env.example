ANTHROPIC_API_KEY=
CLAUDE_ROADMAP_KEY=rmk_7Xb9pQz4Mn2wBjLt8dRvY6sGhCeF0uAo

# Cloud sync data store (used by /api/cloud-data for cross-device sync)
# Auto-set by Vercel once Blob storage is enabled for this project:
# Vercel dashboard → Storage → Create Database → Blob
BLOB_READ_WRITE_TOKEN=

# Second Blob store, used once the original one (above) fills up its quota.
# Create a second Blob store in the Vercel dashboard (Storage → Create
# Database → Blob, give it a different name), then copy its read-write token
# here. Once set, all new writes go to this store while reads still fall back
# to the old store above for paths that only exist there (see api/_blob-dual.js).
# Leave unset and everything keeps working against the old store alone.
BLOB_READ_WRITE_TOKEN_V2=

# Email notifications for assigned work (via https://resend.com)
RESEND_API_KEY=
# Optional — defaults to "WebLight Ops Hub <onboarding@resend.dev>".
# Once your sending domain is verified in Resend, set this to e.g.
# "WebLight Ops Hub <notifications@weblightmedia.com>"
RESEND_FROM_EMAIL=

# New Postgres-backed PM data model (clients/services/projects/tasks).
# Auto-set by Vercel once Postgres storage is enabled for this project:
# Vercel dashboard → Storage → Create Database → Postgres
# Superseded by the Supabase project below once that cutover is complete.
POSTGRES_URL=

# Supabase project used for realtime client/task sync (see
# supabase/migrations/, api/supabase-config.js, lib/supabaseClient.js,
# lib/taskBoard.js, task-board.html).
# From your Supabase project: Project Settings → API.
# NEXT_PUBLIC_SUPABASE_URL is the "Project URL"; NEXT_PUBLIC_SUPABASE_ANON_KEY
# is the "anon public" key (safe to expose to the browser — access is
# controlled by the RLS policies in supabase/migrations/, not by keeping this
# key secret). Named with the NEXT_PUBLIC_ prefix to match what's already set
# in this project's Vercel env vars.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key for the same Supabase project, used by lib/supabaseAdmin.js
# and api/import-legacy-data.js to read/write the ops_* tables (the relational
# replacement for Vercel Blob's cloud-data.json — see supabase/migrations/).
# From your Supabase project: Project Settings → API → "service_role" secret.
# SERVER-ONLY — this key bypasses Row Level Security entirely. NEVER send it
# to the browser, NEVER prefix it with NEXT_PUBLIC_, NEVER import
# lib/supabaseAdmin.js from anything other than an api/*.js file.
SUPABASE_SERVICE_ROLE_KEY=

# Required to call /api/migrate-schema or /api/import-legacy-data — pick any
# long random string yourself and set it in Vercel env vars. These endpoints
# refuse to run at all if this isn't set (fail closed).
MIGRATION_SECRET=

# Required for the daily account-data backup cron (/api/backup-cloud-data,
# see vercel.json "crons"). Pick any long random string and set it in Vercel
# env vars — Vercel automatically sends it as a Bearer token when it invokes
# the cron job. The endpoint refuses to run at all if this isn't set
# (fail closed), same pattern as MIGRATION_SECRET above.
CRON_SECRET=
