ANTHROPIC_API_KEY=
# NOTE: this used to contain a real-looking hardcoded value here. It has been
# blanked as part of the Supabase migration — rotate the actual key in Vercel
# env vars if you haven't already, since the old value was committed to git
# history and must be treated as compromised.
CLAUDE_ROADMAP_KEY=

# Email notifications for assigned work (via https://resend.com)
RESEND_API_KEY=
# Optional — defaults to "WebLight Ops Hub <onboarding@resend.dev>".
# Once your sending domain is verified in Resend, set this to e.g.
# "WebLight Ops Hub <notifications@weblightmedia.com>"
RESEND_FROM_EMAIL=

# ── Supabase (the app's only cloud data store) ──────────────────────────────
# From your Supabase project: Project Settings → API.
# Only the URL + service-role key are needed — the browser never talks to
# Supabase directly, so no anon/public key is required by the main app.
SUPABASE_URL=

# SERVER-ONLY — bypasses Row Level Security entirely. NEVER send it to the
# browser, NEVER prefix it with NEXT_PUBLIC_, NEVER import lib/supabaseAdmin.js
# from anything other than an api/*.js file.
SUPABASE_SERVICE_ROLE_KEY=

# Signs the session tokens issued by /api/ops-auth and verified by
# /api/ops-state and /api/ops-sync. Pick any long random string yourself.
# Required — these endpoints refuse to run without it (fail closed). Changing
# this value invalidates all existing logins (everyone has to sign in again).
SESSION_SECRET=

# Required by /api/migrate-schema (one-time schema setup) — pick any long
# random string yourself. The endpoint refuses to run at all if this isn't
# set (fail closed). /api/import-legacy-data (Phase 5 client import) does NOT
# use this — it's gated on a signed super-admin session instead, same as
# every other ops-* endpoint.
MIGRATION_SECRET=
